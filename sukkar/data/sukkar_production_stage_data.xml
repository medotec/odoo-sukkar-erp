<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Production steps (Kitchen board, status = In Progress) -->
    <record id="stage_piping" model="sukkar.production.stage">
        <field name="name">Piping</field>
        <field name="sequence">10</field>
        <field name="default_duration">30</field>
        <field name="status">in_progress</field>
        <field name="kitchen_stage" eval="True"/>
    </record>
    <record id="stage_cooling" model="sukkar.production.stage">
        <field name="name">Cooling</field>
        <field name="sequence">20</field>
        <field name="default_duration">120</field>
        <field name="status">in_progress</field>
        <field name="kitchen_stage" eval="True"/>
    </record>
    <record id="stage_wrapping" model="sukkar.production.stage">
        <field name="name">Wrapping</field>
        <field name="sequence">30</field>
        <field name="default_duration">20</field>
        <field name="status">in_progress</field>
        <field name="kitchen_stage" eval="True"/>
    </record>
    <record id="stage_packing" model="sukkar.production.stage">
        <field name="name">Packing</field>
        <field name="sequence">40</field>
        <field name="default_duration">10</field>
        <field name="status">in_progress</field>
        <field name="kitchen_stage" eval="True"/>
    </record>
    <record id="stage_accessories" model="sukkar.production.stage">
        <field name="name">Accessories</field>
        <field name="sequence">50</field>
        <field name="default_duration">10</field>
        <field name="status">in_progress</field>
        <field name="kitchen_stage" eval="True"/>
    </record>
    <!-- Bridge: last Kitchen column AND first Delivery column. Stock consumed here. -->
    <record id="stage_ready" model="sukkar.production.stage">
        <field name="name">Ready for Pickup</field>
        <field name="sequence">60</field>
        <field name="default_duration">0</field>
        <field name="is_done" eval="True"/>
        <field name="status">ready_for_pickup</field>
        <field name="kitchen_stage" eval="True"/>
        <field name="delivery_stage" eval="True"/>
    </record>
    <!-- Delivery board only -->
    <record id="stage_in_delivery" model="sukkar.production.stage">
        <field name="name">In Delivery</field>
        <field name="sequence">70</field>
        <field name="default_duration">0</field>
        <field name="is_done" eval="True"/>
        <field name="status">in_delivery</field>
        <field name="delivery_stage" eval="True"/>
    </record>
    <record id="stage_delivered" model="sukkar.production.stage">
        <field name="name">Delivered</field>
        <field name="sequence">80</field>
        <field name="default_duration">0</field>
        <field name="is_done" eval="True"/>
        <field name="status">delivered</field>
        <field name="delivery_stage" eval="True"/>
    </record>
    <record id="stage_closed" model="sukkar.production.stage">
        <field name="name">Closed</field>
        <field name="sequence">90</field>
        <field name="default_duration">0</field>
        <field name="is_done" eval="True"/>
        <field name="is_closed" eval="True"/>
        <field name="status">closed</field>
        <field name="delivery_stage" eval="True"/>
        <field name="fold" eval="True"/>
    </record>
</odoo>
