<?xml version="1.0" encoding="utf-8"?>
<!-- The flavours the shop starts with. noupdate so renaming, archiving or
     adding to them in the UI is never undone by a module upgrade. -->
<odoo noupdate="1">
    <record id="sukkar_flavour_mixed" model="sukkar.cake.flavour">
        <field name="name">Mixed Cake Flavours</field>
        <field name="name_ar">نكهات متنوعة</field>
        <field name="code">MIX</field>
        <field name="sequence">1</field>
        <field name="is_mixed" eval="True"/>
    </record>
    <record id="sukkar_flavour_vanilla" model="sukkar.cake.flavour">
        <field name="name">Vanilla</field>
        <field name="name_ar">فانيلا</field>
        <field name="code">VAN</field>
        <field name="sequence">10</field>
    </record>
    <record id="sukkar_flavour_chocolate" model="sukkar.cake.flavour">
        <field name="name">Chocolate</field>
        <field name="name_ar">شوكولاتة</field>
        <field name="code">CHO</field>
        <field name="sequence">20</field>
    </record>
    <record id="sukkar_flavour_red_velvet" model="sukkar.cake.flavour">
        <field name="name">Red Velvet</field>
        <field name="name_ar">ريد فيلفيت</field>
        <field name="code">RV</field>
        <field name="sequence">30</field>
    </record>
</odoo>
