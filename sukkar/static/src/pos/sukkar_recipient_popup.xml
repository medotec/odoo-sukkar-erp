<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Who receives this delivery, and where (owner's design, 29 Sep 2026).
         One question at a time: keeping it or sending it · which person ·
         which of their addresses. Everything typed here is saved under the
         customer, so the next order for the same person is two taps. -->
    <t t-name="sukkar.RecipientPopup">
        <Dialog title.translate="Who receives this?" size="'lg'">
            <div class="d-flex flex-column gap-3 ks-recipient">

                <div t-if="state.loading" class="text-center py-4">Loading…</div>

                <!-- ============================================ the question -->
                <t t-if="!state.loading and state.step === 'who'">
                    <div class="row g-2">
                        <div class="col-6">
                            <button class="ks-choice w-100 btn btn-lg btn-light"
                                    t-att-disabled="!state.customer"
                                    t-on-click="() => this.chooseCustomer()">
                                <i class="fa fa-home fa-2x d-block mb-1" role="img"/>
                                <span class="d-block fw-bolder">The customer</span>
                                <span class="d-block small"
                                      t-esc="state.customer ? state.customer.name : 'No customer picked yet'"/>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="ks-choice w-100 btn btn-lg btn-light"
                                    t-att-disabled="!state.customer"
                                    t-on-click="() => this.chooseGift()">
                                <i class="fa fa-gift fa-2x d-block mb-1" role="img"/>
                                <span class="d-block fw-bolder">Send as a gift</span>
                                <span class="d-block small">To someone else</span>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- ====================================== which person (gift) -->
                <t t-if="state.step === 'gift'">
                    <div t-if="!state.recipients.length" class="text-muted">
                        This customer has not sent a gift before.
                    </div>
                    <div class="d-grid gap-2">
                        <button t-foreach="state.recipients" t-as="who" t-key="who.id"
                                class="ks-person btn btn-light text-start"
                                t-on-click="() => this.pickRecipient(who.id)">
                            <span class="fw-bolder d-block" t-esc="who.name"/>
                            <small class="d-block text-muted" t-esc="summarise(who)"/>
                        </button>
                        <button class="btn btn-secondary text-start"
                                t-on-click="() => this.startNewPerson()">
                            <i class="fa fa-plus me-2" role="img"/>New recipient
                        </button>
                    </div>
                </t>

                <!-- ================================= which of their addresses -->
                <t t-if="state.step === 'address' and person">
                    <div class="fw-bolder" t-esc="person.name"/>
                    <div class="d-grid gap-2">
                        <button t-foreach="addresses" t-as="addr" t-key="addr.id"
                                class="ks-address btn text-start"
                                t-att-class="addr.id === state.addressId ? 'btn-primary' : 'btn-light'"
                                t-on-click="() => this.pickAddress(addr.id)">
                            <span class="fw-bolder d-block">
                                <t t-esc="addr.label or 'Address'"/>
                                <small t-if="addr.is_primary" class="ms-2">· primary</small>
                            </span>
                            <small class="d-block">
                                <t t-esc="addr.where"/>
                                <span class="ks-addr-fee ms-2">
                                    <i class="fa fa-motorcycle me-1" role="img"/>
                                    <t t-esc="feeLabel(addr)"/>
                                </span>
                            </small>
                        </button>
                        <div t-if="!addresses.length" class="text-muted">
                            No address saved for this person yet.
                        </div>
                        <button class="btn btn-secondary text-start"
                                t-on-click="() => this.startNewAddress()">
                            <i class="fa fa-plus me-2" role="img"/>New address
                        </button>
                    </div>

                    <div>
                        <label class="form-label">Driver</label>
                        <select class="form-select" t-model="state.driver_id">
                            <option value="0">Not assigned yet</option>
                            <t t-foreach="state.drivers" t-as="driver" t-key="driver.id">
                                <option t-att-value="driver.id" t-esc="driver.name"/>
                            </t>
                        </select>
                    </div>

                    <!-- What the driver should know about THIS delivery; the
                         address's own directions travel with the address. -->
                    <button t-if="!state.showNote" class="btn btn-light text-start"
                            t-on-click="() => { this.state.showNote = true; }">
                        <i class="fa fa-sticky-note me-2" role="img"/>Delivery note
                    </button>
                    <div t-else="">
                        <label class="form-label">Delivery note</label>
                        <textarea class="form-control" rows="2" t-model="state.deliveryNote"
                                  placeholder="Call before arriving, leave with the guard…"/>
                    </div>
                </t>

                <!-- ============================================ a new person -->
                <t t-if="state.step === 'new-person'">
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label fw-bolder">Name *</label>
                            <input type="text" class="form-control" t-model="state.person.name"
                                   placeholder="Who receives the gift" autofocus="autofocus"/>
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bolder">Phone *</label>
                            <input type="tel" class="form-control" t-model="state.person.phone"
                                   placeholder="Their phone"/>
                        </div>
                        <div class="col-4">
                            <label class="form-label">E-mail</label>
                            <input type="email" class="form-control" t-model="state.person.email"
                                   placeholder="optional"/>
                        </div>
                    </div>
                    <hr class="my-1"/>
                    <div class="fw-bolder">Their first address</div>
                    <t t-call="sukkar.RecipientAddressForm"/>
                </t>

                <!-- =========================================== a new address -->
                <t t-if="state.step === 'new-address' and person">
                    <div class="fw-bolder">Another address for <t t-esc="person.name"/></div>
                    <t t-call="sukkar.RecipientAddressForm"/>
                </t>

                <div t-if="state.error" class="alert alert-warning mb-0 py-2"
                     t-esc="state.error"/>
            </div>

            <t t-set-slot="footer">
                <t t-if="state.step === 'address'">
                    <button class="btn btn-primary btn-lg" t-att-disabled="state.saving"
                            t-on-click="() => this.confirm()">Save</button>
                    <button class="btn btn-secondary btn-lg"
                            t-on-click="() => this.back()">Back</button>
                    <button class="btn btn-link" t-on-click="() => this.clear()">
                        Clear
                    </button>
                </t>
                <t t-elif="state.step === 'new-person'">
                    <button class="btn btn-primary btn-lg" t-att-disabled="state.saving"
                            t-on-click="() => this.saveNewPerson()">Save recipient</button>
                    <button class="btn btn-secondary btn-lg"
                            t-on-click="() => this.back()">Back</button>
                </t>
                <t t-elif="state.step === 'new-address'">
                    <button class="btn btn-primary btn-lg" t-att-disabled="state.saving"
                            t-on-click="() => this.saveNewAddress()">Save address</button>
                    <button class="btn btn-secondary btn-lg"
                            t-on-click="() => this.back()">Back</button>
                </t>
                <t t-elif="state.step === 'gift'">
                    <button class="btn btn-secondary btn-lg"
                            t-on-click="() => this.back()">Back</button>
                </t>
                <t t-else="">
                    <button class="btn btn-secondary btn-lg"
                            t-on-click="() => this.props.close()">Cancel</button>
                </t>
            </t>
        </Dialog>
    </t>

    <!-- The address form, exactly as a customer's own address is filled in
         (LOCKED #3, #4, #7): governorate then area picked from what that
         governorate contains; block, street and building typed. -->
    <t t-name="sukkar.RecipientAddressForm">
        <div class="d-flex flex-column gap-2">
            <div class="row g-2">
                <div class="col-12">
                    <label class="form-label">Address name</label>
                    <input type="text" class="form-control" t-model="state.address.label"
                           placeholder="Home, Office, Mum's house"/>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label fw-bolder">Governorate *</label>
                    <select class="form-select" t-model="state.address.state_id"
                            t-on-change="() => this.onGovernorateChange()">
                        <option value="0">—</option>
                        <t t-foreach="state.states" t-as="gov" t-key="gov.id">
                            <option t-att-value="gov.id" t-esc="gov.name"/>
                        </t>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bolder">Area *</label>
                    <select class="form-select" t-model="state.address.area_id"
                            t-att-disabled="!state.areas.length">
                        <option value="0" t-esc="state.areas.length ? '—' : 'Choose a governorate first'"/>
                        <t t-foreach="state.areas" t-as="area" t-key="area.id">
                            <option t-att-value="area.id" t-esc="area.display_name"/>
                        </t>
                    </select>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label">Block</label>
                    <input type="text" class="form-control" t-model="state.address.block"/>
                </div>
                <div class="col-4">
                    <label class="form-label">Street</label>
                    <input type="text" class="form-control" t-model="state.address.street"/>
                </div>
                <div class="col-4">
                    <label class="form-label">Avenue</label>
                    <input type="text" class="form-control" t-model="state.address.avenue"/>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label">House</label>
                    <input type="text" class="form-control" t-model="state.address.building"/>
                </div>
                <div class="col-4">
                    <label class="form-label">Floor</label>
                    <input type="text" class="form-control" t-model="state.address.floor"/>
                </div>
                <div class="col-4">
                    <label class="form-label">Apartment</label>
                    <input type="text" class="form-control" t-model="state.address.apartment"/>
                </div>
            </div>
            <div>
                <label class="form-label">Directions for the driver</label>
                <textarea class="form-control" rows="2" t-model="state.address.directions"
                          placeholder="Landmark, gate colour, which entrance"/>
            </div>
        </div>
    </t>
</templates>
