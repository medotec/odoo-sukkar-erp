<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================= -->
    <!-- ORDERS SCREEN — every order across its whole lifecycle, with  -->
    <!-- one-click stage advance / close, regardless of which board.    -->
    <!-- ============================================================= -->

    <!-- ============ ORDERS LIST ============ -->
    <record id="sukkar_orders_view_list" model="ir.ui.view">
        <field name="name">sukkar.production.orders.list</field>
        <field name="model">sukkar.production</field>
        <!-- higher number = lower priority, so the Kitchen/Delivery boards
             keep using their own default list, not this one -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Orders" editable="bottom" create="0" delete="0"
                  default_order="delivery_datetime asc"
                  decoration-danger="is_late == True"
                  decoration-muted="status == 'closed'"
                  decoration-bf="status == 'ready_for_pickup'">
                <field name="name" string="Ticket"/>
                <field name="sale_order_id" string="Order" optional="show"/>
                <field name="partner_id" string="Customer"/>
                <field name="line_summary" string="Items" optional="hide"/>
                <field name="delivery_datetime" string="Delivery"/>
                <field name="delivery_time_range" string="Window" optional="hide"/>
                <field name="amount_total" string="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_status" string="Payment" optional="show" widget="badge"
                       decoration-success="payment_status == 'PAID'"
                       decoration-danger="payment_status == 'UNPAID'"/>
                <field name="payment_method" string="Method" optional="hide"/>
                <field name="knet_approval" string="KNET Approval" optional="hide"/>
                <field name="payment_reference" string="Payment Link Ref." optional="hide"/>
                <!-- blank while nothing is owed; amber as a cash order ages,
                     red once it is past the limit in Settings → Sukkar -->
                <field name="cod_overdue" column_invisible="1"/>
                <field name="cod_days_outstanding" string="Days Unpaid" optional="show"
                       widget="badge" invisible="cod_days_outstanding == 0"
                       decoration-danger="cod_overdue == True"
                       decoration-warning="cod_overdue == False"/>
                <field name="driver_id" string="Driver" optional="show"/>
                <!-- plain (not badge) so it is editable inline: pick ANY stage from the row -->
                <field name="stage_id" string="Stage"/>
                <field name="status" string="Status" widget="badge"
                       decoration-info="status == 'in_progress'"
                       decoration-warning="status == 'ready_for_pickup'"
                       decoration-primary="status == 'in_delivery'"
                       decoration-success="status in ('delivered', 'closed')"/>
                <field name="is_late" column_invisible="1"/>
                <!-- one-click payment + lifecycle actions, straight from the list -->
                <button name="action_mark_paid" type="object" string="Mark Paid"
                        icon="fa-money" invisible="payment_status != 'UNPAID'"
                        help="Record that payment was received"/>
                <button name="action_mark_unpaid" type="object" string="Mark Unpaid"
                        icon="fa-undo" invisible="payment_status != 'PAID'"
                        help="Undo a manual payment confirmation"/>
                <button name="action_picked_up" type="object" string="Picked Up"
                        icon="fa-dolly" invisible="status != 'ready_for_pickup'"
                        help="Collected by the driver — start delivery"/>
                <button name="action_delivered" type="object" string="Delivered"
                        icon="fa-check-circle" invisible="status != 'in_delivery'"
                        help="Mark delivered (stamps driver + time)"/>
                <button name="action_close" type="object" string="Close"
                        icon="fa-lock" invisible="status != 'delivered'"
                        help="Close the order — final step"/>
            </list>
        </field>
    </record>

    <!-- ============ ORDERS CALENDAR (by delivery date) ============ -->
    <record id="sukkar_orders_view_calendar" model="ir.ui.view">
        <field name="name">sukkar.production.orders.calendar</field>
        <field name="model">sukkar.production</field>
        <field name="arch" type="xml">
            <!-- DATE, not the derived datetime — see the note on the Deliveries
                 calendar. Dragging a card moves the delivery day. -->
            <calendar string="Orders" date_start="delivery_date"
                      color="stage_id" mode="month" quick_create="0">
                <field name="partner_id"/>
                <field name="status"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount_total"/>
            </calendar>
        </field>
    </record>

    <!-- ============ ORDERS SEARCH ============ -->
    <record id="sukkar_orders_view_search" model="ir.ui.view">
        <field name="name">sukkar.production.orders.search</field>
        <field name="model">sukkar.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Ticket / Order"
                       filter_domain="['|', ('name', 'ilike', self), ('sale_order_id.name', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="driver_id"/>
                <field name="stage_id"/>
                <separator/>
                <filter name="open" string="Open (not closed)" domain="[('status', '!=', 'closed')]"/>
                <filter name="late" string="Late" domain="[('is_late', '=', True)]"/>
                <separator/>
                <filter name="f_in_progress" string="In Progress" domain="[('status', '=', 'in_progress')]"/>
                <filter name="f_ready" string="Ready for Pickup" domain="[('status', '=', 'ready_for_pickup')]"/>
                <filter name="f_in_delivery" string="In Delivery" domain="[('status', '=', 'in_delivery')]"/>
                <filter name="f_delivered" string="Delivered" domain="[('status', '=', 'delivered')]"/>
                <filter name="f_closed" string="Closed" domain="[('status', '=', 'closed')]"/>
                <separator/>
                <filter name="f_paid" string="Paid" domain="[('sale_order_id.sukkar_payment_status', '=', 'PAID')]"/>
                <filter name="f_unpaid" string="Unpaid" domain="[('sale_order_id.sukkar_payment_status', '=', 'UNPAID')]"/>
                <filter name="f_cod_overdue" string="Cash Overdue"
                        domain="[('sale_order_id.sukkar_cod_overdue', '=', True)]"/>
                <filter name="no_delivery_date" string="No Delivery Date" domain="[('delivery_datetime', '=', False)]"/>
                <separator/>
                <filter name="today" string="Delivery Today"
                        domain="[('delivery_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('delivery_datetime', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ORDERS ACTION ============ -->
    <record id="sukkar_orders_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sukkar.production</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="view_id" ref="sukkar_orders_view_list"/>
        <field name="search_view_id" ref="sukkar_orders_view_search"/>
        <field name="domain">[('sale_order_id', '!=', False)]</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders yet</p>
            <p>Every confirmed order appears here across its whole lifecycle —
               In Progress → Ready for Pickup → In Delivery → Delivered → Closed.
               Use the buttons to advance or close an order, switch to the
               <b>Kanban</b> to drag between stages, or open one to see full details.</p>
        </field>
    </record>

    <!-- ============ QUOTATIONS (owner, 2 Oct 2026) ============
         A price offer from the back office: Odoo's own quotation form, with the
         Sukkar tab on it. Send or print it (Arabic page); when the customer
         agrees, Confirm makes it a real order and it reaches the kitchen. -->
    <record id="sukkar_quotations_action" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{'default_sukkar_paid': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quotations yet</p>
            <p>Make a price offer for a customer, print or send it, and confirm it
               once they agree — it then becomes an order for the kitchen.</p>
        </field>
    </record>
</odoo>
