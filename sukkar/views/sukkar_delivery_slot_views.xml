<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sukkar_delivery_slot_view_list" model="ir.ui.view">
        <field name="name">sukkar.delivery.slot.list</field>
        <field name="model">sukkar.delivery.slot</field>
        <field name="arch" type="xml">
            <list string="Delivery Slots" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="order_count" string="Orders" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sukkar_delivery_slot_view_form" model="ir.ui.view">
        <field name="name">sukkar.delivery.slot.form</field>
        <field name="model">sukkar.delivery.slot</field>
        <field name="arch" type="xml">
            <form string="Delivery Slot">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="order_count" readonly="1"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        The <b>start</b> of the window is the delivery time the kitchen
                        works back from. Finish-By = start minus the
                        "Finish Before Delivery" setting (Settings → Sukkar).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sukkar_delivery_slot_action" model="ir.actions.act_window">
        <field name="name">Delivery Slots</field>
        <field name="res_model">sukkar.delivery.slot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a delivery slot</p>
            <p>Slots are the delivery windows offered to customers, e.g. 18:00-20:00.</p>
        </field>
    </record>
</odoo>
