<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ KITCHEN BOARD (kanban) ============ -->
    <record id="sukkar_production_view_kanban" model="ir.ui.view">
        <field name="name">sukkar.production.kanban</field>
        <field name="model">sukkar.production</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="stage_id"/>
                <field name="is_late"/>
                <field name="color"/>
                <field name="kanban_state"/>
                <field name="partner_id"/>
                <field name="line_summary"/>
                <field name="delivery_datetime"/>
                <field name="delivery_time_range"/>
                <field name="deadline"/>
                <field name="user_id"/>
                <field name="driver_id"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="current_minutes"/>
                <field name="overrun_count"/>
                <field name="order_note"/>
                <field name="has_note_image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{record.is_late.raw_value ? 'oe_kanban_card_danger' : ''}">
                            <div class="o_kanban_record_top mb4">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span t-if="record.is_late.raw_value"
                                      class="badge text-bg-danger float-end">LATE</span>
                            </div>
                            <div><i class="fa fa-user me-1" title="Customer"/><field name="partner_id"/></div>
                            <div class="text-muted" style="white-space:pre-line"><field name="line_summary"/></div>
                            <!-- The till's internal note, in red (owner, 10 Oct 2026). -->
                            <div t-if="record.order_note.value or record.has_note_image.raw_value"
                                 class="border-start border-3 border-danger text-danger fw-bold ps-2 my-1 small"
                                 style="white-space:pre-line;">
                                📝 <t t-esc="record.order_note.value"/>
                                <span t-if="record.has_note_image.raw_value"> 📷 Photo</span>
                            </div>
                            <div t-if="record.delivery_datetime.raw_value">
                                <i class="fa fa-truck me-1" title="Delivery"/>
                                <field name="delivery_datetime"/>
                                <t t-if="record.delivery_time_range.value"> (<t t-esc="record.delivery_time_range.value"/>)</t>
                            </div>
                            <div t-if="record.deadline.raw_value" class="text-danger">
                                <i class="fa fa-clock-o me-1" title="Finish by"/>finish by <field name="deadline"/>
                            </div>
                            <div class="text-muted">
                                <i class="fa fa-hourglass-half me-1" title="Time in current step"/>
                                <t t-esc="record.current_minutes.value"/> min in step
                                <span t-if="record.overrun_count.raw_value &gt; 0"
                                      class="badge text-bg-warning float-end">overrun</span>
                            </div>
                            <div t-if="record.driver_id.raw_value" class="text-muted">
                                <i class="fa fa-id-badge me-1" title="Driver"/><field name="driver_id"/>
                            </div>
                            <div class="o_kanban_record_bottom mt4">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority"/>
                                    <field name="kanban_state" widget="state_selection"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ LIST ============ -->
    <record id="sukkar_production_view_list" model="ir.ui.view">
        <field name="name">sukkar.production.list</field>
        <field name="model">sukkar.production</field>
        <field name="arch" type="xml">
            <list default_order="delivery_datetime asc" decoration-danger="is_late == True"
                  decoration-muted="is_done == True">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="line_summary" optional="show"/>
                <field name="delivery_datetime"/>
                <field name="delivery_time_range" optional="show"/>
                <field name="deadline"/>
                <field name="stage_id"/>
                <field name="status" widget="badge" optional="show"/>
                <field name="total_minutes" optional="hide"/>
                <field name="user_id"/>
                <field name="is_late" optional="hide"/>
                <field name="is_done" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="sukkar_production_view_form" model="ir.ui.view">
        <field name="name">sukkar.production.form</field>
        <field name="model">sukkar.production</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_picked_up" type="object" string="Mark Picked Up"
                            class="oe_highlight" invisible="status != 'ready_for_pickup'"/>
                    <button name="action_delivered" type="object" string="Mark Delivered"
                            class="oe_highlight" invisible="status != 'in_delivery'"/>
                    <button name="action_close" type="object" string="Close Order"
                            invisible="status != 'delivered'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            invisible="payment_status != 'UNPAID'"/>
                    <button name="action_mark_unpaid" type="object" string="Mark Unpaid"
                            invisible="payment_status != 'PAID'"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_mrp" type="object" class="oe_stat_button"
                                icon="fa-industry" invisible="mrp_production_count == 0">
                            <field name="mrp_production_count" widget="statinfo" string="Mfg Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="status" widget="badge"
                               decoration-info="status == 'in_progress'"
                               decoration-warning="status == 'ready_for_pickup'"
                               decoration-primary="status == 'in_delivery'"
                               decoration-success="status in ('delivered', 'closed')"/>
                    </div>
                    <group>
                        <group string="Order">
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="line_summary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="payment_status"/>
                            <field name="payment_method"/>
                            <field name="knet_approval"
                                   invisible="payment_method != 'knet'"/>
                            <field name="payment_reference"
                                   invisible="payment_method != 'link'"/>
                        </group>
                        <group string="Schedule">
                            <field name="delivery_datetime"/>
                            <field name="delivery_time_range"/>
                            <field name="deadline" readonly="1"/>
                            <field name="is_late" readonly="1"/>
                        </group>
                        <group string="Assignment">
                            <field name="user_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state" widget="state_selection"/>
                        </group>
                        <group string="Delivery">
                            <field name="driver_id"/>
                            <field name="delivery_note"
                                   placeholder="e.g. received by Mr. Ahmed, left at reception"/>
                            <field name="delivered_at" readonly="1"
                                   invisible="not delivered_at"/>
                            <field name="delivered_by" readonly="1"
                                   invisible="not delivered_by"/>
                        </group>
                        <!-- Every note in red (owner, 10 Oct 2026). -->
                        <group string="Notes">
                            <field name="special_requests" class="text-danger fw-bold"/>
                            <field name="order_note" class="text-danger fw-bold"/>
                            <field name="has_note_image" invisible="1"/>
                            <field name="note_pictures_html" readonly="1"
                                   invisible="not has_note_image"/>
                        </group>
                        <group string="Timing">
                            <field name="current_minutes"/>
                            <field name="total_minutes"/>
                            <field name="overrun_count"/>
                        </group>
                    </group>
                    <separator string="Step Times"/>
                    <field name="stage_log_ids" readonly="1">
                        <list decoration-danger="overrun == True" decoration-muted="is_open == True">
                            <field name="stage_id"/>
                            <field name="entered_at"/>
                            <field name="exited_at"/>
                            <field name="planned_min"/>
                            <field name="duration_min" string="Actual (min)"/>
                            <field name="overrun"/>
                            <field name="is_open" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="sukkar_production_view_search" model="ir.ui.view">
        <field name="name">sukkar.production.search</field>
        <field name="model">sukkar.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <filter name="late" string="Late" domain="[('is_late', '=', True)]"/>
                <filter name="open" string="In Progress" domain="[('is_done', '=', False)]"/>
                <filter name="my" string="My Tickets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="today" string="Delivery Today"
                        domain="[('delivery_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('delivery_datetime', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_user" string="Assigned" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="sukkar_production_action" model="ir.actions.act_window">
        <field name="name">Kitchen Board</field>
        <field name="res_model">sukkar.production</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('stage_id.kitchen_stage', '=', True)]</field>
        <field name="context">{'board': 'kitchen'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No kitchen tickets yet</p>
            <p>Tickets appear here automatically when a sales order is confirmed.
               They flow Piping → … → Ready for Pickup, then move to the Delivery board.</p>
        </field>
    </record>

    <record id="sukkar_delivery_board_action" model="ir.actions.act_window">
        <field name="name">Delivery Board</field>
        <field name="res_model">sukkar.production</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('stage_id.delivery_stage', '=', True)]</field>
        <field name="context">{'board': 'delivery'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders ready for delivery</p>
            <p>Orders appear here once the kitchen marks them <b>Ready for Pickup</b>.
               Drag: Ready for Pickup → In Delivery → Delivered → Closed.</p>
        </field>
    </record>
</odoo>
