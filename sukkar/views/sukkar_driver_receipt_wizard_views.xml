<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Print beside a driver's name on the Drivers screen (owner, 10 Oct 2026):
         his orders, all ticked; untick what should not print. -->
    <record id="sukkar_driver_receipt_wizard_form" model="ir.ui.view">
        <field name="name">sukkar.driver.receipt.wizard.form</field>
        <field name="model">sukkar.driver.receipt.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="to_print" widget="boolean_toggle"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="addr_area" readonly="1"/>
                        <field name="addr_block" readonly="1"/>
                        <field name="delivery_date" readonly="1"/>
                        <field name="delivery_time_range" readonly="1"/>
                        <field name="cash_due" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="status" readonly="1" widget="badge"/>
                    </list>
                </field>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary btn-lg" icon="fa-print"/>
                    <button string="Cancel" special="cancel" class="btn-secondary btn-lg"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
