<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The cake stock screen. The two figures the owner asked for are shown
         SEPARATELY and totalled at the foot of the list:
           Physical Remaining = Opening + Received − Sold − Waste/Expired
           Available          = Physical Remaining − Reserved for Tomorrow -->
    <record id="sukkar_cake_batch_view_list" model="ir.ui.view">
        <field name="name">sukkar.cake.batch.list</field>
        <field name="model">sukkar.cake.batch</field>
        <field name="arch" type="xml">
            <list string="Cake Stock">
                <field name="name"/>
                <field name="receipt_date"/>
                <field name="production_date" optional="hide"/>
                <field name="expiry_date" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="qty_received" sum="Received"/>
                <field name="qty_undecorated" sum="Undecorated"/>
                <field name="qty_decorated" sum="Decorated"/>
                <field name="qty_sold" sum="Sold" optional="show"/>
                <field name="qty_waste" sum="Wasted"/>
                <field name="qty_physical" sum="Physical Remaining"/>
                <field name="qty_reserved" sum="Reserved for Tomorrow"/>
                <field name="qty_available" sum="Available"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="sukkar_cake_batch_view_form" model="ir.ui.view">
        <field name="name">sukkar.cake.batch.form</field>
        <field name="model">sukkar.cake.batch</field>
        <field name="arch" type="xml">
            <form string="Cake Piece Batch">
                <header>
                    <button name="action_sukkar_open" type="object" class="btn-primary"
                            string="Open" invisible="state != 'draft'"/>
                    <button name="action_sukkar_decorate" type="object"
                            string="Move to Display Fridge"
                            invisible="state != 'open'"/>
                    <button name="action_sukkar_move_pieces" type="object"
                            string="Move Pieces" invisible="state != 'open'"/>
                    <button name="action_sukkar_waste" type="object"
                            string="Write Off Waste" invisible="state != 'open'"/>
                    <button name="action_sukkar_close" type="object"
                            string="Close" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sukkar_moves" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="move_count" widget="statinfo" string="Movements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Received">
                            <field name="receipt_date"/>
                            <field name="production_date"/>
                            <field name="expiry_date"/>
                            <field name="qty_received"/>
                            <field name="qty_opening"/>
                        </group>
                        <group string="Supplier">
                            <field name="partner_id"/>
                            <field name="supplier_invoice_id"/>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Where the pieces are">
                            <field name="qty_undecorated"/>
                            <field name="qty_decorated"/>
                            <field name="qty_reserved"/>
                            <field name="qty_waste"/>
                        </group>
                        <group string="The two figures">
                            <field name="qty_sold"/>
                            <field name="qty_physical"/>
                            <field name="qty_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements" name="moves">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="move_type"/>
                                    <field name="qty"/>
                                    <field name="state_from"/>
                                    <field name="state_to"/>
                                    <field name="sale_order_id"/>
                                    <field name="user_id"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sukkar_cake_batch_view_search" model="ir.ui.view">
        <field name="name">sukkar.cake.batch.search</field>
        <field name="model">sukkar.cake.batch</field>
        <field name="arch" type="xml">
            <search string="Cake Stock">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="today" string="Received Today"
                        domain="[('receipt_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="has_pieces" string="Still Has Pieces"
                        domain="[('qty_physical', '&gt;', 0)]"/>
                <filter name="expired" string="Past Use By"
                        domain="[('expiry_date', '!=', False),
                                 ('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_receipt_date" string="Received On"
                            context="{'group_by': 'receipt_date'}"/>
                    <filter name="group_partner" string="Supplier"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sukkar_cake_batch_action" model="ir.actions.act_window">
        <field name="name">Cake Stock</field>
        <field name="res_model">sukkar.cake.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sukkar_cake_batch_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record today's cake delivery</p>
            <p>Each day's delivery is its own batch: how many pieces arrived, and when.</p>
        </field>
    </record>
</odoo>
