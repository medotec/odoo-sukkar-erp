<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Who is a delivery driver is configuration on the user, not a list in
         code: this checkbox feeds every driver dropdown in the system. -->
    <record id="sukkar_view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.sukkar</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="sukkar_is_driver"/>
            </xpath>
        </field>
    </record>
</odoo>
