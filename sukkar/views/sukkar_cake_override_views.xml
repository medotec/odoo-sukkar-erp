<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sukkar_cake_override_view_list" model="ir.ui.view">
        <field name="name">sukkar.cake.override.list</field>
        <field name="model">sukkar.cake.override</field>
        <field name="arch" type="xml">
            <list string="Stock Overrides" create="false">
                <field name="name"/>
                <field name="override_datetime"/>
                <field name="manager_id"/>
                <field name="sale_order_id"/>
                <field name="pos_order_id" optional="hide"/>
                <field name="qty_needed"/>
                <field name="qty_available"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="sukkar_cake_override_view_form" model="ir.ui.view">
        <field name="name">sukkar.cake.override.form</field>
        <field name="model">sukkar.cake.override</field>
        <field name="arch" type="xml">
            <form string="Stock Override" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="manager_id"/>
                            <field name="override_datetime"/>
                        </group>
                        <group>
                            <field name="qty_needed"/>
                            <field name="qty_available"/>
                        </group>
                    </group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="pos_order_id"/>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sukkar_cake_override_action" model="ir.actions.act_window">
        <field name="name">Stock Overrides</field>
        <field name="res_model">sukkar.cake.override</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No overrides</p>
            <p>Every time a manager confirmed an order without enough cake pieces,
               it is written down here — who, when and why.</p>
        </field>
    </record>
</odoo>
